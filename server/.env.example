# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_dev

# Browser origins allowed by CORS (comma-separated)
CORS_ORIGIN=http://localhost:5173

# Auth - generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-64-character-hex-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-character-hex-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=12

# Rate limiting (per client IP)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30

# Payments
# mock simulates the gateway locally; production is forced to razorpay by env validation.
PAYMENT_MODE=mock
# Razorpay dashboard keys. Test-mode keys are fine for development. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=replace-with-your-test-key-secret
# Generate local secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RAZORPAY_WEBHOOK_SECRET=replace-with-your-webhook-secret

# Cloudinary (optional) - admin image uploads return 503 until all three are set.
# Use the API key and secret from the Cloudinary dashboard. Never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ecommerce-platform
