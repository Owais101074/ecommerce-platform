# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_dev

# Browser origins allowed by CORS (comma-separated)
CORS_ORIGIN=http://localhost:5173

# Auth - generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-64-character-hex-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-character-hex-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=12
